<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gemini_bg"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gemini_bg"
            app:elevation="0dp"
            app:title="Editor"
            app:titleCentered="true"
            app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
            app:layout_constraintTop_toTopOf="parent"
            app:menu="@menu/main_menu" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.Material3.CircularProgressIndicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:indeterminateTint="@color/gemini_accent_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/gemini_bg"
        app:headerLayout="@layout/nav_header"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="180dp"
            android:paddingHorizontal="16dp">

            <!-- 1) Sezione MODELLI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modelli"
                android:textAllCaps="true"
                android:textColor="@color/gemini_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navBtnElecnor"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Elecnor"
                app:icon="@android:drawable/ic_menu_add"
                app:cornerRadius="28dp"
                android:textAlignment="viewStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navBtnSertori"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sertori"
                app:icon="@android:drawable/ic_menu_add"
                app:cornerRadius="28dp"
                android:textAlignment="viewStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navBtnSirti"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sirti"
                app:icon="@android:drawable/ic_menu_add"
                app:cornerRadius="28dp"
                android:textAlignment="viewStart" />

            <!-- 2) Separatore -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gemini_border"
                android:layout_marginVertical="16dp" />

            <!-- 3) Aggiungi riga -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/navBtnAddRow"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Aggiungi riga"
                app:icon="@android:drawable/ic_input_add"
                app:iconTint="@color/gemini_accent_blue"
                android:textColor="@color/gemini_accent_blue"
                app:cornerRadius="28dp"
                android:textAlignment="viewStart" />

            <!-- 4) Reset File -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/navBtnResetFile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Reset File"
                app:icon="@android:drawable/ic_menu_rotate"
                app:iconTint="@color/gemini_accent_red"
                android:textColor="@color/gemini_accent_red"
                app:cornerRadius="28dp"
                android:textAlignment="viewStart" />

            <!-- 5) Separatore -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gemini_border"
                android:layout_marginVertical="16dp" />

            <!-- 6) Materiali di consumo -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/navBtnConsumo"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Materiali di consumo"
                app:icon="@android:drawable/ic_menu_add"
                app:cornerRadius="28dp"
                android:textAlignment="viewStart" />

            <!-- 7) Separatore -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gemini_border"
                android:layout_marginVertical="16dp" />

            <!-- 8) OPZIONI CONDIVISIONE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opzioni Condivisione"
                android:textAllCaps="true"
                android:textColor="@color/gemini_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- 9) Checkbox nome tecnico -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbIncludeTechName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Includi nome tecnico"
                android:textColor="@color/gemini_text_main"
                app:buttonTint="@color/gemini_accent_blue" />

            <!-- 10) Checkbox data odierna -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbIncludeDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Includi data odierna"
                android:textColor="@color/gemini_text_main"
                app:buttonTint="@color/gemini_accent_blue" />

            <!-- 11) Separatore -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gemini_border"
                android:layout_marginVertical="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 12) Sezione TECNICO -->
            <LinearLayout
                android:id="@+id/layoutTechName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tecnico"
                    android:textAllCaps="true"
                    android:textColor="@color/gemini_text_secondary"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvTechName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non impostato"
                    android:textColor="@color/gemini_accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
