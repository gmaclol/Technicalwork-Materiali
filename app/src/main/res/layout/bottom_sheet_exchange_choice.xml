<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/gemini_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exchange_title"
        android:textColor="@color/gemini_text_main"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exchange_subtitle"
        android:textColor="@color/gemini_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateQr"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/exchange_generate_qr"
        app:icon="@drawable/ic_qr_code"
        app:iconTint="@color/gemini_accent_blue"
        app:cornerRadius="28dp"
        android:textAlignment="viewStart"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanQr"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/exchange_scan_qr"
        app:icon="@android:drawable/ic_menu_camera"
        app:iconTint="@color/gemini_accent_blue"
        app:cornerRadius="28dp"
        android:textAlignment="viewStart"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Spacer per bottom insets -->
    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

</LinearLayout>
